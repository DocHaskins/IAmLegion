!DiffLevelTable(s, i)//table name, number of progress levels
!ToxicProbality(i, i)//progress, toxic prob
!BlisterProbality(i, i)//progress, blister prob
!BurningProbality(i, i)//progress, buring probality
!DiffLevelPresets(i, s, s)//progress, channel 0 preset, channel 1 preset, channel 2 preset, channel 3 preset

!PresetsProb1(i, s, i)
!PresetsProb2(i, s, i, s, i)
!PresetsProb3(i, s, i, s, i, s, i)
!PresetsProb4(i, s, i, s, i, s, i, s, i)

!CrowdZombieLevelDef(s, s, s,i)//preset, skin, pool_name, inital_damage
!CrowdZombieLevelDefScale(s, s, s, i, f, i)//preset, skin, pool_name, inital_damage, scale, can spawn

//<<Prologue Start>>												-diff=0  
//<<Airdrop Start>>													-diff=1
//<<After Cutscene with Rais>>										-diff=2
//<<Start of Arena>>												-diff=2
//<<After turning on first antenna>>								-diff=3
//<<After turning on second antenna>>								-diff=4  
//<<After talking with Rais at the end of Antennas mission>>		-diff=5
//<<After finishing job in Fisherman's Village>>					-diff=6
//<<After finding a lost patrol for Karim>>							-diff=7
//<<After Explosives mission initiation>>							-diff=8
//<<After second Prime initiation>>									-diff=9
//<<After finishing Prime Hunting mission>>							-diff=10
//<<When the overpass is reached during Demolition mission>>		-diff=11
//<<After killing Rahim>>											-diff=12
//<<Start of Warehouse mission>>									-diff=13   
//<<End of Arena>>													-diff=14
//<<After Old Town opening scene>>									-diff=15
//<<When Player is leaving the university>>							-diff=16
//<<Project Mayhem mission start>>									-diff=17
//<<Project Mayhem mission end>>									-diff=18
//<<After Rais invitation cutscene>>								-diff=19
//<<End of Clinic mission>>											-diff=20

//On top of that the player Survivor is taken into consideration:
//Diff_level + ((status_level - diff_level/3)/3) 		<= 26			- Base game
//(status_level + player_reputation + DarkMagicFactor)	<= 22			- The Following, DarkMagicFactor = -8

